<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ========================================================================= -->
  <!-- COMBAT EXTENDED (CE) CARRY WEIGHT ADOPTION PROFILE                        -->
  <!-- ========================================================================= -->

  <OverHaulers.MassCapacityStatProfileDef>
    <defName>OverHaulers_Profile_CE</defName>
    <label>Combat Extended</label>
    <modPackageId>ceteam.combatextended</modPackageId>
    <statDefName>CarryWeight</statDefName>
    <priority>200</priority>
    <hostLabelShort>CE</hostLabelShort>
    <!-- Allows authoritative control over Mass Capacity (CE CarryWeight) calculations -->
    <allowAuthoritativeTakeover>true</allowAuthoritativeTakeover>
    <!-- Neutralise and override specific capacity factors under authoritative takeover -->
    <neutraliseCapacityFactors>
      <li>Moving</li>
    </neutraliseCapacityFactors>
    <neutraliseStatFactors>
      <li>bodySizeFactor</li>
    </neutraliseStatFactors>
    <!-- Lets Over Haulers synchronize caravan/transport formation mass capacities -->
    <syncFormationCapacity>true</syncFormationCapacity>
  </OverHaulers.MassCapacityStatProfileDef>


  <!-- ========================================================================= -->
  <!-- VANILLA EXPANDED FRAMEWORK (VEF) ADOPTION PROFILE                         -->
  <!-- ========================================================================= -->

  <OverHaulers.MassCapacityStatProfileDef>
    <defName>OverHaulers_Profile_VEF</defName>
    <label>Vanilla Expanded Framework</label>
    <modPackageId>OskarPotocki.VanillaFactionsExpanded.Core</modPackageId>
    <statDefName>VEF_MassCarryCapacity</statDefName>
    <priority>100</priority>
    <hostLabelShort>VEF</hostLabelShort>
    <!-- VEF flat offsets do not require AuthoritativeTakeover, nor *Factor overrides -->
  </OverHaulers.MassCapacityStatProfileDef>

</Defs>